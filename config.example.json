{
  "server": {
    "port": 3000
  },
  "immich": {
    "baseUrl": "http://192.168.1.x:2283",
    "apiKey": "your-immich-api-key",
    "albumId": "uuid-of-shared-album",
    "slideshowIntervalSeconds": 15
  },
  "homeAssistant": {
    "baseUrl": "http://homeassistant.local:8123",
    "token": "your-long-lived-access-token",
    "weatherEntity": "weather.forecast_home",
    "temperatureEntity": "sensor.openweathermap_temperature",
    "cameraEntity": "camera.reolink_front_door",
    "cameraTriggerEntities": [
      "binary_sensor.reolink_front_door_visitor",
      "binary_sensor.reolink_front_door_person"
    ],
    "cameraAutoHideSeconds": 30,
    "mediaPlayerEntity": "media_player.kitchen_speaker",
    "flightAwareTriggerEntities": ["input_button.show_flightaware"],
    "temperatureTriggerEntities": ["input_button.show_temps"],
    "temperatureSensors": [
      { "entity": "sensor.basement_temperature", "label": "Basement" },
      { "entity": "sensor.main_bath_temperature", "label": "Main Bath" },
      { "entity": "sensor.office_temperature", "label": "Office" },
      { "entity": "sensor.garage_temperature", "label": "Garage" },
      { "entity": "sensor.guest_bedroom_temperature", "label": "Guest Bedroom" },
      { "entity": "sensor.aiden_room_temperature", "label": "Aiden Room" },
      { "entity": "sensor.dna_room_temperature", "label": "DNA Bedroom" },
      { "entity": "sensor.elizabeth_room_temperature", "label": "Elizabeth Room" }
    ]
  },
  "display": {
    "clockFormat24h": false,
    "temperatureUnit": "F"
  },
  "specialViews": {
    "temperatureDurationSeconds": 120,
    "temperatureCoolBelow": 55,
    "temperatureWarmAtOrAbove": 78,
    "flightAwareDurationSeconds": 120,
    "flightAwareUrl": "http://192.168.10.71:8080/"
  }
}
